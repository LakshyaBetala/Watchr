# ─── Watchr AI Backend Environment Variables ─────────────────────
# Copy this file to .env and fill in your credentials.

# Flask
PORT=5050

# IoT Hardware (ESP8266/ESP32 alarm trigger)
ESP_IP=http://192.168.1.100

# Google Gemini API (for semantic insights)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Alerts (Gmail SMTP)
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# SendGrid (optional, alternative to SMTP)
SENDGRID_API_KEY=

# Supabase (optional, for persistent logging)
SUPABASE_URL=
SUPABASE_KEY=

# Detection Thresholds
FIRE_CONFIDENCE_THRESHOLD=0.45
CROWD_DENSITY_THRESHOLD=50
DWELL_TIME_THRESHOLD=300
